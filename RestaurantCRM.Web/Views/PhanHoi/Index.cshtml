@model PhanHoiViewModel
@{
    ViewData["Title"] = "Lịch sử đánh giá của tôi — Lẩu Phố";
    Layout = "/Shared/_Layout.cshtml";

    // Gom nhóm đánh giá theo mã đơn hàng: mỗi đơn hàng hiển thị 1 thẻ duy nhất
    var orderGroups = Model.PhanHois
        .GroupBy(p => !string.IsNullOrEmpty(p.MaDonHang) ? p.MaDonHang : p.MaDanhGia)
        .OrderByDescending(g => g.Max(x => x.NgayGui))
        .ToList();
}

<div class="page-intro" style="display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:16px; margin-bottom:24px;">
    <div>
        <h1 class="page-title" style="margin:0 0 6px;">Lịch sử đánh giá của tôi</h1>
        <p style="margin:0; color:var(--muted); font-size:15px;">Xem lại những phản hồi bạn đã gửi và lời hồi đáp từ nhà hàng Lẩu Phố.</p>
    </div>
    <a asp-controller="DonHang" asp-action="Index" class="btn secondary" style="padding:10px 20px; font-weight:700; border-radius:10px;">
        Đơn hàng của bạn
    </a>
</div>

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success" style="background:#e8f5e9; border:1px solid #a5d6a7; color:#2e7d32; padding:12px 18px; border-radius:12px; margin-bottom:20px; font-weight:500;">
        @TempData["ThongBao"]
    </div>
}
@if (TempData["Loi"] != null)
{
    <div class="alert alert-danger" style="background:#ffebee; border:1px solid #ef9a9a; color:#c62828; padding:12px 18px; border-radius:12px; margin-bottom:20px; font-weight:500;">
        @TempData["Loi"]
    </div>
}

@if (orderGroups.Count == 0)
{
    <div class="panel empty" style="text-align:center; padding:60px 20px;">
        <h3 style="color:var(--ink); margin-bottom:8px;">Bạn chưa có đánh giá nào</h3>
        <p style="max-width:480px; margin:0 auto 20px; line-height:1.6; color:var(--muted); font-size:14.5px;">
            Mỗi đánh giá của bạn là nguồn động lực to lớn giúp Lẩu Phố hoàn thiện hương vị món ăn và chất lượng phục vụ tốt hơn.
        </p>
        <a asp-controller="DonHang" asp-action="Index" class="btn" style="padding:10px 22px; font-weight:700; border-radius:10px;">
            Đến danh sách đơn hàng
        </a>
    </div>
}
else
{
    <div style="display:flex; flex-direction:column; gap:18px;">
        @foreach (var group in orderGroups)
        {
            var orderId = group.Key;
            // Tìm đánh giá chung của đơn
            var reviewChung = group.FirstOrDefault(x => string.IsNullOrEmpty(x.MaMon) || x.TenMon == "Đánh giá chung đơn hàng") ?? group.First();
            // Các món được chấm điểm riêng
            var dishReviews = group.Where(x => x != reviewChung && !string.IsNullOrEmpty(x.MaMon) && x.TenMon != "Đánh giá chung đơn hàng").ToList();

            // Tổng hợp tất cả câu trả lời từ nhà hàng
            var allReplies = group
                .SelectMany(x => x.TraLois)
                .GroupBy(t => t.MaTraLoi)
                .Select(g => g.First())
                .OrderBy(t => t.NgayGui)
                .ToList();

            <article class="order-card" id="order-@orderId" style="padding:22px 24px; border-radius:16px; border:1px solid var(--line); background:#ffffff; box-shadow:0 2px 12px rgba(0,0,0,0.03);">
                <!-- Header Đơn hàng -->
                <div class="order-top" style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:14px;">
                    <div>
                        <div style="display:flex; align-items:center; gap:8px;">
                            <h3 style="margin:0; font-size:17px; font-weight:750; color:var(--ink);">
                                Đơn hàng #@orderId
                            </h3>
                            <span class="badge" style="background:#f0fdf4; color:#15803d; border:1px solid #bbf7d0; font-size:11.5px; padding:2px 8px;">
                                Đã đánh giá
                            </span>
                        </div>
                        <p style="margin:4px 0 0; font-size:13px; color:var(--muted);">
                            Gửi lúc @reviewChung.NgayGui.ToString("dd/MM/yyyy · HH:mm")
                        </p>
                    </div>

                    <!-- Điểm sao tổng quát -->
                    <div style="display:flex; flex-direction:column; align-items:flex-end; gap:2px;">
                        <div class="stars" style="color:#f59e0b; font-size:18px; letter-spacing:2px;">
                            @String.Concat(Enumerable.Repeat("★", reviewChung.DanhGia ?? 0))@String.Concat(Enumerable.Repeat("☆", 5 - (reviewChung.DanhGia ?? 0)))
                        </div>
                        <small style="font-weight:700; color:#b45309; font-size:12.5px;">
                            @(reviewChung.DanhGia == 5 ? "Tuyệt vời" : reviewChung.DanhGia == 4 ? "Hài lòng" : reviewChung.DanhGia == 3 ? "Bình thường" : "Chưa hài lòng")
                        </small>
                    </div>
                </div>

                <!-- Nhận xét của khách -->
                @if (!string.IsNullOrWhiteSpace(reviewChung.NoiDung))
                {
                    <div style="padding:14px 16px; background:#faf7f5; border-radius:12px; border-left:3.5px solid var(--red); color:var(--ink); font-size:14.5px; line-height:1.6; margin-bottom:14px;">
                        @reviewChung.NoiDung
                    </div>
                }

                <!-- Chi tiết điểm từng món ăn (nếu có) -->
                @if (dishReviews.Count > 0)
                {
                    <div style="margin-bottom:14px; border-top:1px dashed var(--line); padding-top:12px;">
                        <div style="font-size:12.5px; font-weight:700; color:var(--muted); text-transform:uppercase; margin-bottom:8px; letter-spacing:0.5px;">
                            Đánh giá từng món (@dishReviews.Count món)
                        </div>
                        <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(260px, 1fr)); gap:8px;">
                            @foreach (var d in dishReviews)
                            {
                                <div style="display:flex; justify-content:space-between; align-items:center; background:#ffffff; border:1px solid var(--line); border-radius:8px; padding:8px 12px; font-size:13px;">
                                    <span style="font-weight:600; color:var(--ink); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; margin-right:8px;">
                                        @d.TenMon
                                    </span>
                                    <span style="color:#f59e0b; font-weight:700; letter-spacing:1px; white-space:nowrap;">
                                        @String.Concat(Enumerable.Repeat("★", d.DanhGia ?? 0))
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Phản hồi từ Nhà hàng Lẩu Phố -->
                @if (allReplies.Count > 0)
                {
                    <div style="margin-top:14px; background:#fffbf7; border:1px solid #fed7aa; border-radius:12px; padding:14px 16px;">
                        <div style="margin-bottom:8px;">
                            <strong style="font-size:13.5px; color:#c2410c;">Phản hồi từ Nhà hàng Lẩu Phố</strong>
                        </div>
                        <div style="display:flex; flex-direction:column; gap:8px;">
                            @foreach (var reply in allReplies)
                            {
                                <div style="font-size:13.5px; color:var(--ink); line-height:1.5;">
                                    @reply.NoiDung
                                    <div style="font-size:11.5px; color:var(--muted); margin-top:3px;">
                                        @reply.NgayGui.ToString("dd/MM/yyyy · HH:mm")
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Thanh tác vụ dưới chân card -->
                <div style="display:flex; justify-content:flex-end; align-items:center; gap:10px; margin-top:14px; padding-top:12px; border-top:1px solid var(--line);">
                    <a asp-action="ChiTiet" asp-route-maHoaDon="@orderId" class="btn secondary" style="padding:6px 14px; font-size:12.5px; font-weight:600; border-radius:8px; background:#e0f2fe; border-color:#bae6fd; color:#0369a1;">
                        Xem chi tiết đánh giá
                    </a>
                    <a asp-action="ChinhSua" asp-route-maHoaDon="@orderId" class="btn secondary" style="padding:6px 14px; font-size:12.5px; font-weight:600; border-radius:8px;">
                        Chỉnh sửa
                    </a>
                    <a asp-controller="DonHang" asp-action="ChiTiet" asp-route-id="@orderId" class="btn secondary" style="padding:6px 14px; font-size:12.5px; font-weight:600; border-radius:8px;">
                        Xem đơn hàng
                    </a>
                </div>
            </article>
        }
    </div>
}
