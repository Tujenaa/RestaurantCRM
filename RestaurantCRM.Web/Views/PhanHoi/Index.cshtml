@model PhanHoiViewModel
@{
    ViewData["Title"] = "Lịch sử đánh giá của tôi — Lẩu Phố";
    Layout = "/Shared/_Layout.cshtml";
}

<div class="page-intro" style="display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:16px; margin-bottom:28px;">
    <div>
        <h1 class="page-title" style="margin:0 0 6px;">Lịch sử đánh giá của tôi</h1>
        <p style="margin:0; color:var(--muted); font-size:15px;">Xem lại những phản hồi bạn đã gửi và các câu trả lời giải đáp từ nhà hàng Lẩu Phố.</p>
    </div>
    <a asp-controller="DonHang" asp-action="Index" class="btn" style="padding:12px 24px; font-weight:700; border-radius:12px; display:inline-flex; align-items:center; gap:8px; box-shadow:0 4px 14px rgba(225,29,72,0.25);">
        Đánh giá từ đơn hàng của bạn
    </a>
</div>

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success" style="background:#e8f5e9; border:1px solid #a5d6a7; color:#2e7d32; padding:12px 18px; border-radius:12px; margin-bottom:20px; font-weight:500;">
        @TempData["ThongBao"]
    </div>
}
@if (TempData["Loi"] != null)
{
    <div class="alert alert-danger" style="background:#ffebee; border:1px solid #ef9a9a; color:#c62828; padding:12px 18px; border-radius:12px; margin-bottom:20px; font-weight:500;">
        @TempData["Loi"]
    </div>
}

<section class="panel review-history-card" style="box-shadow: 0 4px 20px rgba(0,0,0,0.06); border-radius:16px; padding:24px 28px;">
    <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--line); padding-bottom:14px; margin-bottom:20px;">
        <div style="display:flex; align-items:center; gap:10px;">
            <div>
                <strong style="font-size:16px; color:#1e293b;">Danh sách các đánh giá đã gửi</strong>
                <small class="muted" style="display:block; font-size:12.5px;">Sắp xếp từ mới nhất đến cũ nhất kèm trao đổi phản hồi</small>
            </div>
        </div>
        <span class="badge" style="background:#e0f2fe; color:#0369a1; font-weight:700; font-size:13px; padding:6px 12px; border-radius:20px;">
            @Model.PhanHois.Count đánh giá
        </span>
    </div>

    @if (Model.PhanHois.Count == 0)
    {
        <div style="text-align:center; padding:60px 20px; color:var(--muted);">
            <h3 style="color:#334155; margin-bottom:8px;">Bạn chưa có đánh giá nào</h3>
            <p style="max-width:480px; margin:0 auto 20px; line-height:1.6; font-size:14.5px;">
                Mỗi đánh giá của bạn là nguồn động lực to lớn giúp Lẩu Phố hoàn thiện hương vị món ăn và chất lượng phục vụ.
            </p>
            <a asp-controller="DonHang" asp-action="Index" class="btn" style="padding:10px 20px; font-weight:600; border-radius:10px;">
                Đến danh sách đơn hàng để đánh giá
            </a>
        </div>
    }
    else
    {
        <div class="reviews-stream" style="display:flex; flex-direction:column; gap:20px;">
            @foreach (var review in Model.PhanHois)
            {
                <article class="review-item" style="border:1px solid var(--line); border-radius:14px; padding:20px 22px; background:#ffffff; transition:box-shadow 0.2s ease;">
                    <!-- Header Đánh giá -->
                    <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:12px; flex-wrap:wrap; gap:10px;">
                        <div style="display:flex; align-items:center; gap:12px;">
                            <div style="width:44px; height:44px; border-radius:50%; background:#fef3c7; color:#b45309; display:flex; align-items:center; justify-content:center; font-weight:bold; font-size:18px;">
                                @(string.IsNullOrEmpty(review.TenKhachHang) ? "K" : review.TenKhachHang[0].ToString().ToUpper())
                            </div>
                            <div>
                                <strong style="font-size:15px; color:#1e293b; display:block;">@review.TenKhachHang (Bạn)</strong>
                                <small class="muted" style="font-size:13px;">
                                    Món ăn: <strong style="color:var(--text);">@review.TenMon</strong> 
                                    @(!string.IsNullOrEmpty(review.MaDonHang) ? $" · Đơn hàng #{review.MaDonHang}" : "")
                                </small>
                            </div>
                        </div>
                        <div style="text-align:right;">
                            <div class="stars" style="color:#f59e0b; font-size:18px; letter-spacing:2px;">
                                @String.Concat(Enumerable.Repeat("★", review.DanhGia))@String.Concat(Enumerable.Repeat("☆", 5 - review.DanhGia))
                            </div>
                            <small class="muted" style="font-size:12px;">@review.NgayGui.ToString("dd/MM/yyyy · HH:mm")</small>
                        </div>
                    </div>

                    <!-- Nội dung nhận xét -->
                    <div style="margin:10px 0 16px; line-height:1.65; color:#334155; font-size:15px; background:#f8fafc; padding:12px 16px; border-radius:10px; border-left:4px solid #f59e0b;">
                        @review.NoiDung
                    </div>

                    <!-- Khung Phản hồi / Hội thoại từ mới đến cũ -->
                    @if (review.TraLois != null && review.TraLois.Count > 0)
                    {
                        <div class="reply-thread" style="margin-top:14px; background:#f1f5f9; border-radius:12px; padding:14px 16px; border-left: 3px solid #3b82f6;">
                            <div style="font-size:12px; font-weight:700; color:#475569; text-transform:uppercase; margin-bottom:10px; display:flex; justify-content:space-between;">
                                <span>Phản hồi trao đổi (@review.TraLois.Count câu trả lời · Mới nhất trước)</span>
                            </div>
                            <div style="display:flex; flex-direction:column; gap:10px;">
                                @foreach (var reply in review.TraLois)
                                {
                                    <div class="reply-box" style="padding:10px 14px; border-radius:10px; background:@(reply.NguoiGui == "NhanVien" ? "#eff6ff" : "#ffffff"); border:1px solid @(reply.NguoiGui == "NhanVien" ? "#bfdbfe" : "#e2e8f0"); font-size:13.5px;">
                                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
                                            <span style="font-weight:700; color:@(reply.NguoiGui == "NhanVien" ? "#1d4ed8" : "#334155");">
                                                @(reply.NguoiGui == "NhanVien" ? reply.NguoiTraLoi + " (Nhà hàng)" : reply.NguoiTraLoi + " (Bạn)")
                                            </span>
                                            <small class="muted" style="font-size:11.5px;">@reply.NgayGui.ToString("dd/MM/yyyy · HH:mm")</small>
                                        </div>
                                        <div style="color:#1e293b; line-height:1.5;">@reply.NoiDung</div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                </article>
            }
        </div>
    }
</section>
