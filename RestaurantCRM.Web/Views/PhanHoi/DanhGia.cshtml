@model PhanHoiViewModel
@{
    ViewData["Title"] = "Đánh giá đơn hàng — Lẩu Phố";
    Layout = "/Shared/_Layout.cshtml";

    var dishes = Model.ChiTietMonDanhGia ?? new List<DishReviewInputItem>();
}

<div class="page-intro" style="max-width:760px; margin:0 auto 24px; text-align:center;">
    <div style="margin-bottom:10px;">
        <a asp-action="Index" style="text-decoration:none; color:var(--muted); font-size:13.5px; font-weight:600; display:inline-flex; align-items:center; gap:6px;">
            ← Xem lịch sử đánh giá của bạn
        </a>
    </div>
    <h1 class="page-title" style="font-size:26px; margin-bottom:6px;">Đánh giá đơn hàng</h1>
    <p style="color:var(--muted); font-size:14.5px; margin:0;">
        Ý kiến của bạn là động lực giúp Lẩu Phố không ngừng nâng cao chất lượng món ăn và phục vụ.
    </p>
</div>

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success" style="max-width:760px; margin:0 auto 20px; background:#e8f5e9; border:1px solid #a5d6a7; color:#2e7d32; padding:12px 18px; border-radius:12px; font-weight:500;">
        @TempData["ThongBao"]
    </div>
}
@if (TempData["Loi"] != null)
{
    <div class="alert alert-danger" style="max-width:760px; margin:0 auto 20px; background:#ffebee; border:1px solid #ef9a9a; color:#c62828; padding:12px 18px; border-radius:12px; font-weight:500;">
        @TempData["Loi"]
    </div>
}

<div style="max-width:760px; margin:0 auto 40px;">
    <form class="panel review-form-card" asp-action="Gui" method="post" style="box-shadow: 0 4px 20px rgba(0,0,0,0.05); padding:28px 32px; border-radius:18px; border:1px solid var(--line); background:#ffffff;">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="validation" style="color:#d32f2f; margin-bottom:16px;"></div>

        <!-- Chọn đơn hàng -->
        <div class="field" style="margin-bottom:22px;">
            <label for="MaDonHang" style="font-weight:700; display:block; margin-bottom:8px; font-size:14px; color:var(--ink);">
                Đơn hàng đánh giá
            </label>
            @if (Model.DonHangs.Count > 0)
            {
                <select id="MaDonHang" name="MaDonHang" required class="form-select" onchange="location.href='?maDonHang=' + this.value" style="width:100%; padding:11px 14px; border-radius:10px; border:1px solid var(--line); background:#fafafa; font-size:14px; font-weight:600; color:var(--ink);">
                    @foreach (var order in Model.DonHangs)
                    {
                        <option value="@order.MaDonHang" selected="@(Model.MaDonHang == order.MaDonHang)">
                            Đơn hàng #@order.MaDonHang · @order.NgayDat.ToString("dd/MM/yyyy") · @order.TongThanhToan.ToString("N0")đ
                        </option>
                    }
                </select>
            }
            else
            {
                <div style="padding:14px 16px; background:#fff7ed; border:1px solid #fed7aa; border-radius:10px; font-size:14px; color:#c2410c;">
                    Hiện bạn không có đơn hàng nào cần đánh giá. 
                    <a asp-controller="DonHang" asp-action="Index" style="color:#c2410c; font-weight:700; text-decoration:underline; margin-left:6px;">Xem danh sách đơn hàng</a>
                </div>
            }
            <span asp-validation-for="MaDonHang" class="validation" style="color:#d32f2f; font-size:12px;"></span>
        </div>

        <!-- Mức độ hài lòng về đơn hàng -->
        <div style="margin-bottom:24px; text-align:center; padding:20px; background:#faf7f5; border-radius:14px; border:1px solid #f5ebe6;">
            <label style="font-weight:700; display:block; margin-bottom:10px; font-size:15px; color:var(--ink);">
                Bạn cảm thấy đơn hàng này như thế nào?
            </label>

            <div class="rating" id="ratingStars" role="group" aria-label="Chọn số sao" style="display:inline-flex; justify-content:center; gap:8px; font-size:36px; cursor:pointer; margin-bottom:6px;">
                @for (var i = 1; i <= 5; i++)
                {
                    <button type="button" class="@(i <= Model.DanhGia ? "on" : "")" data-rating="@i" aria-label="@i sao" style="background:none; border:none; cursor:pointer; font-size:38px; line-height:1; padding:0; color:@(i <= Model.DanhGia ? "#f59e0b" : "#d1d5db"); transition:transform 0.15s ease;">★</button>
                }
            </div>
            <input type="hidden" asp-for="DanhGia" id="DanhGia" value="@Model.DanhGia" />
            <div id="ratingLabel" style="font-weight:700; color:#b45309; font-size:14.5px;">
                @(Model.DanhGia == 5 ? "Rất hài lòng" : Model.DanhGia == 4 ? "Hài lòng" : Model.DanhGia == 3 ? "Bình thường" : Model.DanhGia == 2 ? "Chưa hài lòng" : "Rất không hài lòng")
            </div>
        </div>

        <!-- Nhận xét chung -->
        <div class="field" style="margin-bottom:24px;">
            <label asp-for="NoiDung" style="font-weight:700; display:block; margin-bottom:6px; font-size:14px; color:var(--ink);">
                Chia sẻ nhận xét chung về đơn hàng <span style="font-size:12.5px; font-weight:normal; color:var(--muted);">(không bắt buộc)</span>
            </label>
            <textarea asp-for="NoiDung" rows="3" placeholder="Hãy cho Lẩu Phố biết cảm nhận của bạn về hương vị món ăn, tốc độ phục vụ hoặc cách đóng gói (không bắt buộc)..." style="width:100%; padding:12px 14px; border-radius:10px; border:1px solid var(--line); font-family:inherit; font-size:14px; line-height:1.5; resize:vertical; background:#ffffff;"></textarea>
            <span asp-validation-for="NoiDung" class="validation" style="color:#d32f2f; font-size:12px;"></span>
        </div>

        <!-- Đánh giá từng món ăn trong đơn (không bắt buộc) -->
        <partial name="_ChamMonTrongDon" model="dishes" />

        <div style="display:flex; gap:12px; align-items:center; padding-top:8px;">
            <button class="btn" type="submit" style="flex:1; padding:13px; font-size:15px; font-weight:700; border-radius:10px;">
                Gửi đánh giá
            </button>
            <a asp-action="Index" class="btn secondary" style="padding:13px 20px; font-size:14.5px; font-weight:600; border-radius:10px;">
                Hủy
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="/Shared/_ValidationScriptsPartial.cshtml" />
    <script src="~/js/cham-mon.js" asp-append-version="true"></script>
    <script>
        const ratingLabels = {
            1: 'Rất không hài lòng',
            2: 'Chưa hài lòng',
            3: 'Bình thường',
            4: 'Hài lòng',
            5: 'Rất hài lòng'
        };

        const stars = document.querySelectorAll('#ratingStars button');
        const hiddenInput = document.getElementById('DanhGia');
        const label = document.getElementById('ratingLabel');

        stars.forEach(star => {
            star.addEventListener('click', function () {
                const val = parseInt(this.getAttribute('data-rating'));
                hiddenInput.value = val;
                if (label && ratingLabels[val]) {
                    label.textContent = ratingLabels[val];
                }
                stars.forEach((s, idx) => {
                    if (idx < val) {
                        s.style.color = '#f59e0b';
                        s.classList.add('on');
                    } else {
                        s.style.color = '#d1d5db';
                        s.classList.remove('on');
                    }
                });
                if (window.ChamMon) window.ChamMon.dongBoTheoDiemChung(val);
            });
        });

    </script>
}
