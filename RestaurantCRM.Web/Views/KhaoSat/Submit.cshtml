@{
    ViewData["Title"] = "Hoàn thành khảo sát — Lẩu Phố";
    Layout = "/Shared/_Layout.cshtml";
}
<div class="page-intro"><h1 class="page-title">Khảo sát khách hàng</h1><p>Chia sẻ trải nghiệm để chúng tôi hiểu bạn hơn.</p></div>

<div class="survey-card">
    <div class="survey-icon">🎉</div>
    <div>
        <h3>Cảm ơn bạn đã hoàn thành khảo sát!</h3>
        <p>Câu trả lời của bạn đã được ghi nhận và giúp Lẩu Phố phục vụ tốt hơn.</p>
    </div>
    <div class="survey-right">
        <span class="status done">Đã hoàn thành</span>
        <p class="survey-action"><a class="btn small" asp-action="Index">Về danh sách →</a></p>
    </div>
</div>