@model KhaoSatViewModel?
@{
    ViewData["Title"] = "Khảo sát khách hàng — Lẩu Phố";
    Layout = "/Shared/_Layout.cshtml";
    var done = ViewBag.DaTraLoi is true;
}
<div class="page-intro"><h1 class="page-title">Khảo sát khách hàng</h1><p>Chia sẻ trải nghiệm để chúng tôi hiểu bạn hơn.</p></div>

@if (Model is null)
{
    <div class="panel"><p>Hiện chưa có khảo sát nào đang mở. Vui lòng quay lại sau.</p></div>
}
else
{
    var phut = Math.Max(1, (int)Math.Ceiling(Model.CauHoi.Count * 0.5));
    <div id="surveyListing">
        <div class="survey-card">
            <div class="survey-icon">💬</div>
            <div>
                <h3>@Model.TieuDe</h3>
                <p>Chia sẻ ý kiến để Lẩu Phố phục vụ bạn tốt hơn.</p>
                <p class="survey-meta">⏱ Khoảng @phut phút &nbsp;·&nbsp; @Model.CauHoi.Count câu hỏi</p>
            </div>
            <div class="survey-right">
                @if (done)
                {
                    <span class="status done">Đã tham gia</span>
                    <p class="survey-action"><button class="btn secondary small" type="button" data-toast="Bạn đã hoàn thành khảo sát này.">Xem trạng thái</button></p>
                }
                else
                {
                    <span class="status">Đang mở</span>
                    <p class="survey-action"><a class="btn small" asp-action="Details" asp-route-id="@Model.MaKhaoSat">Bắt đầu →</a></p>
                }
            </div>
        </div>
    </div>
}