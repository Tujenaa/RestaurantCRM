@model KhaoSatIndexViewModel
@{
    ViewData["Title"] = "Khảo sát khách hàng — Lẩu Phố";
    Layout = "/Shared/_Layout.cshtml";
    var isLoggedIn = ViewBag.IsLoggedIn as bool? ?? false;
    var chuaLam = Model.DanhSach.Where(ks => !ks.DaTraLoi).ToList();
    var lichSuDuyNhat = Model.LichSu.DistinctBy(x => x.MaKhaoSat).ToList();
}
<div class="page-intro"><h1 class="page-title">Khảo sát khách hàng</h1><p>Chia sẻ trải nghiệm để chúng tôi hiểu bạn hơn.</p></div>

@if (chuaLam.Count > 0)
{
    var i = 0;
    @foreach (var ks in chuaLam)
    {
        var phut = Math.Max(1, (int)Math.Ceiling(ks.SoCauHoi * 0.5));
        <div class="survey-card">
            <div class="survey-icon">@((++i).ToString("00"))</div>
            <div>
                <h3>@ks.TieuDe</h3>
                <p>Chia sẻ ý kiến để Lẩu Phố phục vụ bạn tốt hơn.</p>
                <p class="survey-meta">Khoảng @phut phút &nbsp;·&nbsp; @ks.SoCauHoi câu hỏi</p>
            </div>
            <div class="survey-right-column">
                <span class="status status-open">Đang mở</span>
                <a class="btn btn-survey" asp-action="Details" asp-route-id="@ks.MaKhaoSat">Bắt đầu</a>
            </div>
        </div>
    }
}
else
{
    <div class="panel">
        @if (lichSuDuyNhat.Count > 0 || (Model.DanhSach.Count > 0 && Model.DanhSach.All(x => x.DaTraLoi)))
        {
            <p>Hiện không còn khảo sát nào cần hoàn thành. Bạn đã hoàn thành tất cả các khảo sát hiện có. Cảm ơn bạn đã đóng góp ý kiến!</p>
        }
        else
        {
            <p>Hiện chưa có khảo sát nào đang mở. Vui lòng quay lại sau.</p>
        }
    </div>
}

<h2 class="survey-history-title">Lịch sử khảo sát</h2>
@if (!isLoggedIn)
{
    <div class="panel"><p class="muted">Vui lòng <a asp-controller="TaiKhoan" asp-action="DangNhap" style="color:var(--red); font-weight:600; text-decoration:underline;">đăng nhập</a> để xem lịch sử khảo sát của bạn.</p></div>
}
else if (lichSuDuyNhat.Count == 0)
{
    <div class="panel"><p class="muted">Bạn chưa tham gia khảo sát nào.</p></div>
}
else
{
    @foreach (var item in lichSuDuyNhat)
    {
        <div class="panel history-item">
            <div class="order-top">
                <div>
                    <strong>@item.TieuDe</strong>
                    <p>Đã gửi ngày @item.NgayGui.ToString("dd/MM/yyyy")</p>
                </div>
                <span class="status status-completed">Đã hoàn thành</span>
            </div>
        </div>
    }
}
