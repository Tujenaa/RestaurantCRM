@model ErrorViewModel
@{
    ViewData["Title"] = "Có lỗi xảy ra";
    Layout = "/Shared/_Layout.cshtml";
}
<section class="empty-card">
    <div class="empty-icon">⚠️</div>
    <h1>Không thể hoàn tất yêu cầu</h1>
    <p>Đã xảy ra lỗi khi xử lý trang. Vui lòng quay lại trang chủ và thử lại.</p>
    @if (Model.ShowRequestId)
    {
        <p class="muted">Mã yêu cầu: <code>@Model.RequestId</code></p>
    }
    <a class="btn" asp-controller="TrangChu" asp-action="Index">Về trang chủ</a>
</section>
