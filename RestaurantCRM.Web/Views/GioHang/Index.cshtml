@model GioHangPageViewModel
@{
    ViewData["Title"] = "Giỏ hàng — Lẩu Phố";
    Layout = "/Shared/_Layout.cshtml";
    var selectedItems = Model.GioHang.ItemsDaChon;
    var unavailCount = Model.GioHang.Items.Count(x => !x.KhaDung);
}

<div class="page-intro">
    <h1 class="page-title">Giỏ hàng của bạn</h1>
    <p>Kiểm tra món ăn, áp dụng mã ưu đãi và hoàn tất đơn hàng.</p>
</div>

@if (TempData["ThongBao"] is string errMsg && (TempData["IsError"] as bool? == true))
{
    <div class="alert alert-danger" style="background:#ffebee; border:1.5px solid #ef9a9a; color:#c62828; padding:16px 20px; border-radius:14px; margin-bottom:24px; animation:fadeIn .2s;">
        <h4 style="margin:0 0 6px; font-size:15px; font-weight:800; display:flex; align-items:center; gap:8px;">
            Giỏ hàng cần điều chỉnh số lượng hoặc món ăn
        </h4>
        <p style="margin:0; font-size:13.5px; line-height:1.5;">@errMsg</p>
    </div>
}

@if (Model.GioHang.Items.Count == 0)
{
    <div class="panel empty">
        <div class="big"></div>
        <h3>Giỏ hàng đang trống</h3>
        <p>Thêm vài món ngon từ thực đơn để bắt đầu đơn hàng nhé.</p>
        <a class="btn" asp-controller="Menu" asp-action="Index">Khám phá thực đơn ngay →</a>
    </div>
}
else
{
    <div class="layout">
        <section class="panel">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 16px; gap:12px; flex-wrap:wrap;">
                <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
                    <form asp-action="ChonTatCa" method="post" class="js-select-form" style="margin:0;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="chon" value="@(Model.GioHang.DaChonTatCa ? "false" : "true")" />
                        <label class="cart-select-all">
                            <input type="checkbox" class="cart-check js-auto-submit" @(Model.GioHang.DaChonTatCa ? "checked" : "") @(Model.GioHang.SoMonKhaDung == 0 ? "disabled" : "") aria-label="Chọn tất cả món" />
                            Chọn tất cả (@selectedItems.Count/@Model.GioHang.SoMonKhaDung)
                        </label>
                    </form>
                    @if (selectedItems.Count > 0)
                    {
                        <form asp-action="XoaDaChon" method="post" style="margin:0;" data-preserve-scroll>
                            @Html.AntiForgeryToken()
                            <button type="submit" class="remove" title="Xóa tất cả món đang chọn khỏi giỏ hàng">
                                ✕ Xóa đã chọn (@selectedItems.Count)
                            </button>
                        </form>
                    }
                </div>
                <span class="muted" style="font-size:13px;">Đã chọn @selectedItems.Sum(x => x.SoLuong) phần · Trong giỏ @Model.GioHang.Items.Count món</span>
            </div>

            @if (unavailCount > 0)
            {
                <div style="background:#fff7ed; border:1px solid #fed7aa; border-radius:12px; padding:10px 14px; margin-bottom:14px; display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap;">
                    <div style="font-size:13px; color:#9a3412;">
                        Có <strong>@unavailCount</strong> món trong giỏ hiện đang hết hàng hoặc ngừng kinh doanh.
                    </div>
                    <form asp-action="XoaMonKhongKhaDung" method="post" style="margin:0;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn secondary small" style="color:#c62828; border-color:#ef9a9a; background:#fff; font-size:12px; padding:4px 10px; border-radius:6px; cursor:pointer;" title="Xóa tất cả món không khả dụng khỏi giỏ">
                            Xóa món không khả dụng
                        </button>
                    </form>
                </div>
            }

            @foreach (var item in Model.GioHang.Items)
            {
                var unavailable = !item.KhaDung;
                var isSelected = item.DuocChon && item.KhaDung;
                <div class="cart-item cart-item--selectable @(unavailable ? "cart-item--unavailable" : "")">
                    <form asp-action="ChonMon" method="post" class="js-select-form" style="margin:0;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="maMon" value="@item.MaMon" />
                        <input type="hidden" name="chon" value="@(isSelected ? "false" : "true")" />
                        <input type="checkbox" class="cart-check js-auto-submit" @(isSelected ? "checked" : "") @(unavailable ? "disabled" : "")
                               title="@(unavailable ? item.TrangThaiMon : "Chọn món này để đặt")" aria-label="Chọn @item.TenMon" />
                    </form>
                    <div class="mini-art" style="overflow: hidden; padding: 0; background: #fdfaf6; border: 1px solid var(--line);">
                        <img src="@(string.IsNullOrWhiteSpace(item.DuongDanAnh) ? "/images/default.jpg" : item.DuongDanAnh)" alt="@item.TenMon" style="width: 100%; height: 100%; object-fit: cover; border-radius: 12px;" onerror="this.onerror=null;this.src='/images/default.jpg';" />
                    </div>
                    <div>
                        <h4>
                            <a href="/Menu/ChiTiet/@item.MaMon" style="color:inherit;">@item.TenMon</a>
                        </h4>
                        @if (unavailable)
                        {
                            <span class="badge @(item.TrangThaiMon == "Ngừng kinh doanh" ? "badge-discontinued" : "badge-outofstock")" style="font-size:11px;">
                                <span class="badge-dot"></span>@item.TrangThaiMon
                            </span>
                        }
                        else if (item.CoKhuyenMai)
                        {
                            <div style="margin-top: 4px; display: flex; flex-direction: column; gap: 3px;">
                                <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                                    <strong style="color: var(--primary); font-size: 14.5px;">@item.DonGiaSauGiam.ToString("N0")đ</strong>
                                    <span style="font-size: 12.5px; text-decoration: line-through; color: #9ca3af;">@item.DonGiaGoc.ToString("N0")đ</span>
                                    <span class="badge" style="background: #fee2e2; color: #dc2626; font-size: 11px; padding: 2px 7px; border-radius: 4px; font-weight: 700; border: 1px solid #fecaca;">
                                        -@item.PhanTramGiam% (Giảm @item.ChietKhau.ToString("N0")đ/phần)
                                    </span>
                                </div>
                                <div class="price cart-line-total" style="margin-top: 2px;">
                                    @item.ThanhTien.ToString("N0")đ
                                    <span style="font-size: 11.5px; font-weight: 500; color: #16a34a; margin-left: 6px;">
                                        (Tiết kiệm: -@item.TongChietKhau.ToString("N0")đ)
                                    </span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <small>@item.DonGia.ToString("N0")đ / phần</small>
                            <div class="price cart-line-total">@item.ThanhTien.ToString("N0")đ</div>
                        }
                    </div>
                    <div class="cart-item-actions" style="display:flex; flex-direction:column; align-items:flex-end; gap:6px;">
                        @if (!unavailable)
                        {
                            <form asp-action="CapNhat" method="post" class="qty">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="MaMon" value="@item.MaMon" />
                                <button type="submit" name="SoLuong" value="@(item.SoLuong - 1)" aria-label="Giảm số lượng">−</button>
                                <strong>@item.SoLuong</strong>
                                <button type="submit" name="SoLuong" value="@(item.SoLuong + 1)" aria-label="Tăng số lượng">＋</button>
                            </form>
                        }
                        <form asp-action="Xoa" method="post" style="margin:0;" data-preserve-scroll>
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="maMon" value="@item.MaMon" />
                            <button type="submit" class="remove" title="Xóa @item.TenMon khỏi giỏ hàng">✕ Xóa món</button>
                        </form>
                    </div>
                </div>
            }

            <div style="margin-top: 18px; display:flex; justify-content:space-between; align-items:center;">
                <a class="btn secondary small" asp-controller="Menu" asp-action="Index">＋ Chọn thêm món khác</a>
                <span class="muted" style="font-size:12px;">Giao hàng tận nơi 30-45 phút</span>
            </div>
        </section>

        <aside class="panel summary">
            <h3>Tóm tắt đơn hàng</h3>
            @if (Model.GioHang.TongChietKhauMon > 0)
            {
                <div class="summary-line">
                    <span>Tổng tiền món (gốc)</span>
                    <span style="text-decoration: line-through; color: var(--muted);">@Model.GioHang.TongTienGoc.ToString("N0")đ</span>
                </div>
                <div class="summary-line">
                    <span>Chiết khấu món / loại món</span>
                    <strong class="discount-value" style="color: #dc2626;">−@Model.GioHang.TongChietKhauMon.ToString("N0")đ</strong>
                </div>
            }
            <div class="summary-line">
                <span>Tạm tính tiền hàng (@selectedItems.Count món)</span>
                <strong>@Model.GioHang.TamTinh.ToString("N0")đ</strong>
            </div>

            @if (Model.GioHang.GiamGia > 0)
            {
                <div class="summary-line">
                    <span>Ưu đãi voucher (@Model.GioHang.MaVoucher)</span>
                    <strong class="discount-value" style="color: var(--green);">−@Model.GioHang.GiamGia.ToString("N0")đ</strong>
                </div>
            }

            <div class="summary-line total" style="align-items:flex-end;">
                <span>Tổng cộng</span>
                <div style="text-align: right;">
                    @if (Model.GioHang.GiamGia > 0 || Model.GioHang.TongChietKhauMon > 0)
                    {
                        var originalTotal = Model.GioHang.TongTienGoc + Model.GioHang.PhiGiaoHang;
                        <div style="text-decoration: line-through; color: var(--muted); font-size: 14px; margin-bottom: 2px;">
                            @originalTotal.ToString("N0")đ
                        </div>
                    }
                    <div style="color: var(--red); font-size: 20px;">@Model.GioHang.TongThanhToan.ToString("N0")đ</div>
                </div>
            </div>

            <!-- Voucher Section -->
            <div class="voucher-box" style="margin: 20px 0; padding: 14px; background: #fffcf8; border: 1px dashed var(--line); border-radius: 14px;">
                <label for="cartVoucherInput" style="font-size: 13px; font-weight: 750; margin-bottom: 6px;">Mã ưu đãi / Voucher</label>
                <form asp-action="Voucher" method="post" id="cartVoucherForm" class="field" style="margin-bottom: 8px;">
                    @Html.AntiForgeryToken()
                    <div class="voucher-entry" style="display:flex; flex-direction:column; gap:8px;">
                        <input id="cartVoucherInput" name="MaVoucher" value="@Model.GioHang.MaVoucher" placeholder="Nhập mã ưu đãi" style="width:100%;" />
                        <div style="display:flex; gap:6px;">
                            <button class="btn secondary small" type="submit" style="flex:1; width:auto; margin-top:0;">Áp dụng ưu đãi</button>
                            @if (!string.IsNullOrWhiteSpace(Model.GioHang.MaVoucher))
                            {
                                <button class="btn secondary small" type="button" onclick="removeCartVoucher()" title="Gỡ voucher" style="color:var(--red); border-color:#ef9a9a; flex:none; width:auto; margin-top:0; padding:0 16px;">✕ Gỡ</button>
                            }
                        </div>
                    </div>
                </form>

                @{
                    var subtotal = Model.GioHang.TamTinh;
                    var allVouchers = (Model.AvailableVouchers ?? new List<RestaurantCRM.Web.Models.VoucherViewModel>())
                        .OrderByDescending(v => v.GetIneligibleReason(subtotal, selectedItems) == null)
                        .ThenByDescending(v => v.NgayBatDau ?? DateOnly.MinValue)
                        .ThenByDescending(v => v.MaKmvoucher)
                        .ToList();
                    var top5Vouchers = allVouchers.Take(5).ToList();
                }
                <div style="font-size: 11px; color: var(--muted); margin-bottom: 6px;">Bấm để áp dụng nhanh mã ưu đãi:</div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 6px;">
                    @if (!top5Vouchers.Any())
                    {
                        <div style="font-size: 11.5px; color: var(--muted); font-style: italic; padding: 4px 0; grid-column: 1/-1;">
                            Hiện chưa có mã ưu đãi nào trong hệ thống.
                        </div>
                    }
                    else
                    {
                        @foreach (var v in top5Vouchers)
                        {
                            var reason = v.GetIneligibleReason(subtotal, selectedItems);
                            if (reason == null)
                            {
                                <button type="button" class="chip-voucher" onclick="quickApplyVoucher('@v.DisplayCode')" 
                                        title="@v.TenChuongTrinh - @v.ConditionLabel"
                                        style="background:#e8f5e9; border:1px solid #c8e6c9; color:#2e7d32; font-size:11.5px; padding:4px 9px; border-radius:999px; cursor:pointer; font-weight:650;">
                                    @v.DisplayCode (@v.DiscountLabel)
                                </button>
                            }
                            else
                            {
                                <button type="button" class="chip-voucher" disabled aria-disabled="true"
                                        title="@v.TenChuongTrinh - @reason"
                                        style="background:#f1f1f1; border:1px solid #e0e0e0; color:#a8a8a8; font-size:11.5px; padding:4px 9px; border-radius:999px; cursor:not-allowed; filter:grayscale(1); opacity:.75;">
                                    @v.DisplayCode (@v.DiscountLabel)
                                    <span style="display:block; font-size:10px; font-weight:500;">@reason</span>
                                </button>
                            }
                        }
                    }
                </div>

                @if (allVouchers.Count > 0)
                {
                    <button type="button" class="btn-open-voucher-modal" onclick="openVoucherModal()">
                        Xem thêm tất cả ưu đãi (@allVouchers.Count mã) →
                    </button>
                }
            </div>

            @if (selectedItems.Count > 0)
            {
                <a class="btn" asp-action="Checkout" style="display:block; text-align:center; padding:13px; font-size:15px;">Đặt @selectedItems.Count món đã chọn →</a>
            }
            else
            {
                <span class="btn is-disabled" aria-disabled="true" style="display:block; text-align:center; padding:13px; font-size:15px;">Chọn món để đặt hàng</span>
            }
        </aside>
    </div>

    @if (allVouchers != null && allVouchers.Count > 0)
    {
        var usableVouchers = allVouchers.Where(v => v.GetIneligibleReason(subtotal, selectedItems) == null).ToList();
        var otherVouchers = allVouchers.Where(v => v.GetIneligibleReason(subtotal, selectedItems) != null).ToList();

        <div class="voucher-modal" id="voucherModal" aria-hidden="true" role="dialog">
            <div class="voucher-modal__backdrop" onclick="closeVoucherModal()"></div>
            <div class="voucher-modal__dialog">
                <div class="voucher-modal__header">
                    <div>
                        <h3 style="margin:0; font-size:17px; font-weight:800; display:flex; align-items:center; gap:8px;">
                            Danh sách khuyến mãi & ưu đãi (@allVouchers.Count)
                        </h3>
                        <small class="muted" style="font-size:12px;">Ưu tiên các mã bạn có thể áp dụng cho giỏ hàng hiện tại</small>
                    </div>
                    <button type="button" class="voucher-modal__close" onclick="closeVoucherModal()" aria-label="Đóng">✕ Đóng</button>
                </div>
                <div class="voucher-modal__body">
                    @if (usableVouchers.Count > 0)
                    {
                        <div>
                            <div class="voucher-section-title" style="color:#15803d;">
                                Mã có thể áp dụng ngay (@usableVouchers.Count)
                            </div>
                            <div class="voucher-list-cards">
                                @foreach (var v in usableVouchers)
                                {
                                    var isApplied = string.Equals(Model.GioHang.MaVoucher, v.DisplayCode, StringComparison.OrdinalIgnoreCase);
                                    <div class="voucher-card voucher-card--usable @(isApplied ? "voucher-card--applied" : "")">
                                        <div class="voucher-card__left">
                                            <div class="voucher-card__code">
                                                <span>@v.DisplayCode</span>
                                                <span class="badge badge-sale" style="background:#dcfce7; color:#15803d; border:1px solid #bbf7d0;">@v.DiscountLabel</span>
                                                @if (isApplied)
                                                {
                                                    <span class="badge" style="background:#e0f2fe; color:#0369a1; border:1px solid #bae6fd;">Đang áp dụng</span>
                                                }
                                            </div>
                                            <div class="voucher-card__desc">@v.TenChuongTrinh</div>
                                            <div class="voucher-card__condition">
                                                @v.ConditionLabel
                                                @if (v.NgayKetThuc.HasValue)
                                                {
                                                    <span> · HSD: @v.NgayKetThuc.Value.ToString("dd/MM/yyyy")</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="voucher-card__right">
                                            @if (isApplied)
                                            {
                                                <button type="button" class="btn secondary small" onclick="removeCartVoucher(); closeVoucherModal();" style="color:var(--red); border-color:#ef9a9a;">
                                                    Gỡ mã
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn small" onclick="quickApplyVoucher('@v.DisplayCode'); closeVoucherModal();" style="background:var(--green); border-color:var(--green); color:#fff; font-weight:700;">
                                                    Áp dụng
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (otherVouchers.Count > 0)
                    {
                        <div style="margin-top: @(usableVouchers.Count > 0 ? "8px" : "0");">
                            <div class="voucher-section-title" style="color:#64748b;">
                                Các mã ưu đãi khác (@otherVouchers.Count)
                            </div>
                            <div class="voucher-list-cards">
                                @foreach (var v in otherVouchers)
                                {
                                    var reason = v.GetIneligibleReason(subtotal, selectedItems);
                                    <div class="voucher-card voucher-card--disabled">
                                        <div class="voucher-card__left">
                                            <div class="voucher-card__code">
                                                <span>@v.DisplayCode</span>
                                                <span class="badge" style="background:#f1f5f9; color:#475569; border:1px solid #e2e8f0;">@v.DiscountLabel</span>
                                            </div>
                                            <div class="voucher-card__desc">@v.TenChuongTrinh</div>
                                            <div class="voucher-card__condition">
                                                @v.ConditionLabel
                                                @if (v.NgayKetThuc.HasValue)
                                                {
                                                    <span> · HSD: @v.NgayKetThuc.Value.ToString("dd/MM/yyyy")</span>
                                                }
                                            </div>
                                            <div class="voucher-card__ineligible">
                                                @reason
                                            </div>
                                        </div>
                                        <div class="voucher-card__right">
                                            <button type="button" class="btn secondary small" disabled style="opacity:.6; cursor:not-allowed; font-size:12px;">
                                                Chưa đủ ĐK
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    <script>
        function saveScroll() {
            try { sessionStorage.setItem('restoreScrollY', String(window.scrollY || window.pageYOffset)); } catch (e) {}
        }
        // Tick / bỏ tick chọn món: tự gửi form và giữ vị trí cuộn
        document.querySelectorAll('.js-auto-submit').forEach(function (cb) {
            cb.addEventListener('change', function () {
                const form = cb.closest('form');
                if (!form) return;
                saveScroll();
                form.submit();
            });
        });
        function quickApplyVoucher(code) {
            saveScroll();
            const input = document.getElementById('cartVoucherInput');
            const form = document.getElementById('cartVoucherForm');
            if (input && form) {
                input.value = code;
                form.submit();
            }
        }
        function removeCartVoucher() {
            saveScroll();
            const input = document.getElementById('cartVoucherInput');
            const form = document.getElementById('cartVoucherForm');
            if (input && form) {
                input.value = '';
                form.submit();
            }
        }
        function openVoucherModal() {
            const modal = document.getElementById('voucherModal');
            if (modal) {
                modal.classList.add('voucher-modal--open');
                modal.setAttribute('aria-hidden', 'false');
                document.body.style.overflow = 'hidden';
            }
        }
        function closeVoucherModal() {
            const modal = document.getElementById('voucherModal');
            if (modal) {
                modal.classList.remove('voucher-modal--open');
                modal.setAttribute('aria-hidden', 'true');
                document.body.style.overflow = '';
            }
        }
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeVoucherModal();
        });
    </script>
}
