@model MonAnViewModel
@{
    var anh = string.IsNullOrWhiteSpace(Model.DuongDanAnh) ? "/images/default.jpg" : Model.DuongDanAnh;
    var dangGiam = Model.DonGiaSauGiam < Model.DonGia && Model.DonGiaSauGiam > 0;
}

<article class="dish-card @(Model.ConHang ? "" : "dish-card--unavailable")" data-id="@Model.MaMon" data-name="@Model.TenMon" data-category="@Model.MaLoaiMon">
    <div class="dish-card__media">
        <a asp-controller="Menu" asp-action="ChiTiet" asp-route-id="@Model.MaMon" class="dish-card__img-link" title="Xem chi tiết @Model.TenMon">
            <img class="dish-card__img" src="@anh" alt="@Model.TenMon" loading="lazy" onerror="this.onerror=null; this.src='/images/default.jpg';" />
        </a>

        <div class="dish-card__badges">
            @if (dangGiam)
            {
                var pt = Math.Round((1 - (Model.DonGiaSauGiam / Model.DonGia)) * 100);
                <span class="badge badge-sale">Giảm @pt%</span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Tag))
            {
                <span class="badge badge-tag">@Model.Tag</span>
            }
            <span class="badge @Model.TrangThaiBadgeClass">
                <span class="badge-dot"></span>@Model.TrangThaiHienThi
            </span>
        </div>

        <button type="button" class="btn-quick-view" onclick="openQuickView('@Model.MaMon')" title="Xem nhanh món ăn">Xem nhanh</button>
    </div>

    <div class="dish-card__body">
        <div class="dish-card__meta">
            <span class="dish-card__category">@Model.LoaiMon</span>
            <span class="dish-card__rating" title="Điểm đánh giá trung bình từ khách hàng">@Model.DiemDanhGiaTrungBinh.ToString("0.0")/5</span>
        </div>

        <h3 class="dish-card__title">
            <a asp-controller="Menu" asp-action="ChiTiet" asp-route-id="@Model.MaMon" title="@Model.TenMon">@Model.TenMon</a>
        </h3>

        <p class="dish-card__desc" title="@Model.MoTa">@Model.MoTa</p>

        <span class="dish-card__stock @(Model.ConHang ? "text-success" : "text-muted")">
            @(Model.ConHang ? $"Còn {Model.SoLuong} suất" : "Hết món")
        </span>

        <div class="dish-card__footer">
            <div class="dish-card__price-wrap">
                @if (dangGiam)
                {
                    <span class="dish-card__price">@Model.DonGiaSauGiam.ToString("N0") <small>đ</small></span>
                    <span class="dish-card__price-old">@Model.DonGia.ToString("N0") đ</span>
                }
                else
                {
                    <span class="dish-card__price">@Model.DonGia.ToString("N0") <small>đ</small></span>
                }
            </div>

            <div class="dish-card__actions">
                <a asp-controller="Menu" asp-action="ChiTiet" asp-route-id="@Model.MaMon" class="btn-detail" title="Xem chi tiết món">Chi tiết</a>

                @if (Model.ConHang)
                {
                    <form asp-controller="GioHang" asp-action="Them" method="post" class="add-cart-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="MaMon" value="@Model.MaMon" />
                        <input type="hidden" name="SoLuong" value="1" />
                        <button class="btn-add-cart" type="submit" aria-label="Thêm @Model.TenMon vào giỏ">Thêm vào giỏ</button>
                    </form>
                }
                else
                {
                    <button class="btn-add-cart disabled" type="button" disabled>Hết món</button>
                }
            </div>
        </div>
    </div>
</article>
