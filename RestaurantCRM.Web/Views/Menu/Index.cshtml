@model MonAnDanhSachViewModel
@{
    ViewData["Title"] = "Thực đơn món ngon — Lẩu Phố";
    Layout = "/Shared/_Layout.cshtml";
}

<div class="menu-page-container">
    <!-- Hero Banner -->
    <section class="menu-hero">
        <div class="menu-hero__content">
            <span class="menu-hero__eyebrow">✦ TINH HOA NỒI LẨU VIỆT</span>
            <h1 class="menu-hero__title">Thực đơn Lẩu Phố</h1>
            <p class="menu-hero__subtitle">
                Hơn @Model.TongSoMon món lẩu và đồ nhúng tươi ngon thượng hạng. Đặt món giao tận nhà nóng hổi trong 30-45 phút!
            </p>
            <div class="menu-hero__badges">
                <span class="hero-chip">🥬 Rau củ sạch trong ngày</span>
                <span class="hero-chip">🥩 Thịt bò & hải sản tươi sống</span>
                <span class="hero-chip">🥘 Nước lẩu gia truyền đậm vị</span>
            </div>
        </div>
    </section>

    <!-- Toolbar: Search & Category Filter -->
    <section class="menu-toolbar" id="menu-toolbar">
        <div class="menu-toolbar__top">
            <!-- Search Form -->
            <form class="menu-search-form" asp-controller="Menu" asp-action="Index" method="get" id="searchForm">
                @if (!string.IsNullOrEmpty(Model.LoaiDangChon) && Model.LoaiDangChon != "all")
                {
                    <input type="hidden" name="loai" value="@Model.LoaiDangChon" />
                }
                <div class="search-input-wrap">
                    <span class="search-icon">🔍</span>
                    <input type="text"
                           id="dishSearchInput"
                           name="q"
                           value="@Model.TuKhoa"
                           placeholder="Tìm theo tên món (VD: Lẩu Thái, Bò Mỹ, Tôm sú...)"
                           autocomplete="off"
                           aria-label="Tìm kiếm món ăn" />
                    @if (!string.IsNullOrWhiteSpace(Model.TuKhoa))
                    {
                        <a href="@Url.Action("Index", "Menu", new { loai = Model.LoaiDangChon })" class="search-clear" title="Xóa tìm kiếm">✕</a>
                    }
                </div>
                <button type="submit" class="btn btn-search">Tìm kiếm</button>
            </form>

            <!-- Search stats -->
            <div class="menu-stats">
                <span id="dishCounterText">Hiển thị <strong>@Model.TongSoMon</strong> món ăn</span>
            </div>
        </div>

        <!-- Category Filter Tabs -->
        <div class="menu-categories" role="tablist">
            <div class="categories-scroll">
                @foreach (var cat in Model.DanhSachLoaiMon)
                {
                    bool isSelected = (string.IsNullOrEmpty(Model.LoaiDangChon) || Model.LoaiDangChon == "all")
                        ? (cat.MaLoaiMon == "all" || cat.TenLoaiMon == "Tất cả món")
                        : (Model.LoaiDangChon == cat.MaLoaiMon || Model.LoaiDangChon == cat.TenLoaiMon);

                    <a class="category-pill @(isSelected ? "category-pill--active" : "")"
                       asp-controller="Menu"
                       asp-action="Index"
                       asp-route-loai="@(cat.MaLoaiMon == "all" ? null : cat.MaLoaiMon)"
                       asp-route-q="@Model.TuKhoa"
                       data-cat-id="@cat.MaLoaiMon"
                       title="Xem món loại: @cat.TenLoaiMon">
                        <span class="pill-name">@cat.TenLoaiMon</span>
                        @if (cat.SoLuongMon > 0)
                        {
                            <span class="pill-count">@cat.SoLuongMon</span>
                        }
                    </a>
                }
            </div>
        </div>
    </section>

    <!-- Dish Grid Section -->
    <section class="menu-grid-section">
        @if (TempData["ThongBao"] != null)
        {
            <div class="alert alert-info">
                ℹ️ @TempData["ThongBao"]
            </div>
        }

        <div class="dish-grid" id="dishGrid">
            @if (Model.MonAns.Count == 0)
            {
                <div class="menu-empty-state">
                    <div class="empty-icon">🍲</div>
                    <h3>Không tìm thấy món ăn phù hợp</h3>
                    <p>Rất tiếc, không có món nào khớp với tiêu chí tìm kiếm "@Model.TuKhoa".</p>
                    <a asp-controller="Menu" asp-action="Index" class="btn btn-secondary">Xem lại toàn bộ thực đơn</a>
                </div>
            }
            else
            {
                @foreach (var dish in Model.MonAns)
                {
                    <partial name="_DishCard" model="@dish" />
                }
            }
        </div>
    </section>
</div>

<!-- Quick View Modal Container -->
<div class="quickview-modal" id="quickViewModal" aria-hidden="true" role="dialog">
    <div class="quickview-modal__backdrop" onclick="closeQuickView()"></div>
    <div class="quickview-modal__dialog">
        <button class="quickview-modal__close" onclick="closeQuickView()" aria-label="Đóng">✕</button>
        <div class="quickview-modal__content" id="quickViewContent">
            <div class="quickview-loading">
                <div class="spinner"></div>
                <p>Đang tải thông tin món ăn...</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Real-time client-side instant search filter
        const searchInput = document.getElementById('dishSearchInput');
        const dishCards = document.querySelectorAll('.dish-card');
        const counterText = document.getElementById('dishCounterText');

        if (searchInput) {
            searchInput.addEventListener('input', function (e) {
                const query = e.target.value.trim().toLowerCase();
                let visibleCount = 0;

                dishCards.forEach(card => {
                    const name = (card.getAttribute('data-name') || '').toLowerCase();
                    const desc = (card.querySelector('.dish-card__desc')?.textContent || '').toLowerCase();
                    const category = (card.querySelector('.dish-card__category')?.textContent || '').toLowerCase();

                    if (!query || name.includes(query) || desc.includes(query) || category.includes(query)) {
                        card.style.display = '';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                if (counterText) {
                    counterText.innerHTML = `Hiển thị <strong>${visibleCount}</strong> món ăn`;
                }
            });
        }

        // Quick View Modal logic
        function openQuickView(dishId) {
            const modal = document.getElementById('quickViewModal');
            const content = document.getElementById('quickViewContent');
            if (!modal || !content) return;

            modal.classList.add('quickview-modal--open');
            modal.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';

            content.innerHTML = `
                <div class="quickview-loading">
                    <div class="spinner"></div>
                    <p>Đang tải thông tin món ăn...</p>
                </div>
            `;

            fetch(`/Menu/QuickView/${encodeURIComponent(dishId)}`)
                .then(res => {
                    if (!res.ok) throw new Error('Không thể tải món ăn');
                    return res.text();
                })
                .then(html => {
                    content.innerHTML = html;
                    bindQuickViewActions();
                })
                .catch(err => {
                    content.innerHTML = `
                        <div class="quickview-error">
                            <p>⚠️ Không thể tải thông tin món lúc này. Vui lòng mở xem chi tiết trực tiếp.</p>
                            <a href="/Menu/ChiTiet/${encodeURIComponent(dishId)}" class="btn btn-primary">Xem trang chi tiết</a>
                        </div>
                    `;
                });
        }

        function closeQuickView() {
            const modal = document.getElementById('quickViewModal');
            if (modal) {
                modal.classList.remove('quickview-modal--open');
                modal.setAttribute('aria-hidden', 'true');
            }
            document.body.style.overflow = '';
        }

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeQuickView();
        });

        function bindQuickViewActions() {
            const minusBtn = document.getElementById('qvMinusBtn');
            const plusBtn = document.getElementById('qvPlusBtn');
            const qtyInput = document.getElementById('qvQuantityInput');
            const maxQty = parseInt(qtyInput?.getAttribute('max') || '99', 10);

            if (minusBtn && plusBtn && qtyInput) {
                minusBtn.addEventListener('click', () => {
                    let val = parseInt(qtyInput.value || '1', 10);
                    if (val > 1) qtyInput.value = val - 1;
                });
                plusBtn.addEventListener('click', () => {
                    let val = parseInt(qtyInput.value || '1', 10);
                    if (val < maxQty) qtyInput.value = val + 1;
                });
            }
        }
    </script>
}
