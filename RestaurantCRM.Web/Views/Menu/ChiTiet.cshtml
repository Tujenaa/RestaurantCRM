@model MonAnChiTietViewModel
@{
    var dish = Model.MonAn;
    ViewData["Title"] = $"{dish.TenMon} — Chi tiết món ăn Lẩu Phố";
    Layout = "/Shared/_Layout.cshtml";
}

<div class="dish-detail-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb-nav" aria-label="Đường dẫn điều hướng">
        <ol class="breadcrumb-list">
            <li><a asp-controller="TrangChu" asp-action="Index">Trang chủ</a></li>
            <li class="separator">/</li>
            <li><a asp-controller="Menu" asp-action="Index">Thực đơn</a></li>
            <li class="separator">/</li>
            <li><a asp-controller="Menu" asp-action="Index" asp-route-loai="@dish.MaLoaiMon">@dish.LoaiMon</a></li>
            <li class="separator">/</li>
            <li class="current" aria-current="page">@dish.TenMon</li>
        </ol>
    </nav>

    <!-- Main Dish Detail Showcase -->
    <section class="dish-detail-showcase">
        <div class="dish-detail-grid">
            <!-- Left: Media Showcase -->
            <div class="dish-detail-media">
                <div class="media-frame">
                    @if (!string.IsNullOrWhiteSpace(dish.DuongDanAnh))
                    {
                        <img src="@dish.DuongDanAnh" alt="@dish.TenMon" style="width: 100%; height: 100%; object-fit: cover; border-radius: 20px;" onerror="this.onerror=null; this.src='/images/default.jpg';" />
                    }
                    else
                    {
                        <div class="dish-art @dish.Tone" style="height: 100%; border-radius: 0; font-size: 130px; user-select: none;">
                            <span>@dish.BieuTuong</span>
                        </div>
                    }

                    <!-- Floating Badges -->
                    <div class="media-badges">
                        @if (!string.IsNullOrWhiteSpace(dish.Tag))
                        {
                            <span class="badge badge-tag">@dish.Tag</span>
                        }
                        <span class="badge @dish.TrangThaiBadgeClass">
                            <span class="badge-dot"></span>@dish.TrangThaiHienThi
                        </span>
                    </div>
                </div>

                <!-- Feature highlights -->
                <div class="dish-trust-badges">
                    <div class="trust-item">
                        <span class="trust-icon">🥬</span>
                        <div>
                            <strong>Tươi mới mỗi ngày</strong>
                            <p>Nguyên liệu sạch, kiểm định an toàn</p>
                        </div>
                    </div>
                    <div class="trust-item">
                        <span class="trust-icon">⚡</span>
                        <div>
                            <strong>Giao nhanh nóng hổi</strong>
                            <p>Đóng gói giữ nhiệt giao 30-45 phút</p>
                        </div>
                    </div>
                    <div class="trust-item">
                        <span class="trust-icon">🍲</span>
                        <div>
                            <strong>Nồi lẩu gia truyền</strong>
                            <p>Vị đậm đà khó quên</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Product Info & Order Action -->
            <div class="dish-detail-info">
                <div class="dish-meta-header">
                    <span class="category-badge">@dish.LoaiMon</span>
                    <span class="sku-badge">Mã món: <strong>@dish.MaMon</strong></span>
                    <span class="rating-badge" title="Điểm đánh giá trung bình từ thực khách">⭐ @dish.DiemDanhGiaTrungBinh.ToString("0.0") (@(dish.SoLuongDanhGia > 0 ? $"{dish.SoLuongDanhGia} đánh giá" : "Chưa có đánh giá"))</span>
                </div>

                <h1 class="dish-title">@dish.TenMon</h1>

                <!-- Price Box -->
                <div class="dish-price-box">
                    @if (dish.DonGiaSauGiam < dish.DonGia && dish.DonGiaSauGiam > 0)
                    {
                        <div class="price-main">
                            <span class="price-number">@dish.DonGiaSauGiam.ToString("N0")</span>
                            <span class="price-currency">đ</span>
                            <span style="text-decoration:line-through; font-size:16px; color:var(--muted); margin-left:12px; font-weight:normal;">@dish.DonGia.ToString("N0")đ</span>
                        </div>
                    }
                    else
                    {
                        <div class="price-main">
                            <span class="price-number">@dish.DonGia.ToString("N0")</span>
                            <span class="price-currency">đ</span>
                        </div>
                    }
                    <span class="price-vat">/ phần (Đã bao gồm VAT)</span>
                </div>

                <!-- Stock & Availability Info -->
                <div class="dish-availability-card">
                    <div class="availability-row">
                        <span class="avail-label">Trạng thái kinh doanh:</span>
                        <span class="badge @dish.TrangThaiBadgeClass">
                            <span class="badge-dot"></span>@dish.TrangThaiHienThi
                        </span>
                    </div>

                    <div class="availability-row">
                        <span class="avail-label">Số lượng có thể đặt:</span>
                        @if (dish.ConHang)
                        {
                            <div class="stock-counter-wrap">
                                <span class="stock-number text-success">@dish.SoLuong suất có sẵn</span>
                                <div class="stock-progress-bar">
                                    <div class="stock-progress-fill" style="width: @Math.Min(100, Math.Max(15, dish.SoLuong * 2))%;"></div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <span class="stock-number text-danger">Hiện tại đã hết hàng</span>
                        }
                    </div>
                </div>

                <!-- Order Action Form -->
                @if (dish.ConHang)
                {
                    <form asp-controller="GioHang" asp-action="Them" method="post" class="dish-order-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="MaMon" value="@dish.MaMon" />

                        <div class="form-row-quantity">
                            <label for="detailQuantityInput" class="qty-control-label">Chọn số lượng:</label>
                            <div class="quantity-picker">
                                <button type="button" class="btn-qty" id="detailMinusBtn" aria-label="Giảm số lượng">−</button>
                                <input type="number"
                                       name="SoLuong"
                                       id="detailQuantityInput"
                                       value="1"
                                       min="1"
                                       max="@dish.SoLuong"
                                       class="input-qty"
                                       aria-label="Số lượng đặt" />
                                <button type="button" class="btn-qty" id="detailPlusBtn" aria-label="Tăng số lượng">+</button>
                            </div>
                            <span class="qty-limit-note">(Tối đa: @dish.SoLuong suất)</span>
                        </div>

                        <!-- Live Total Preview -->
                        <div class="order-subtotal-preview">
                            <span>Tạm tính:</span>
                            <strong id="liveSubtotalText">@((dish.DonGiaSauGiam > 0 && dish.DonGiaSauGiam < dish.DonGia) ? dish.DonGiaSauGiam.ToString("N0") : dish.DonGia.ToString("N0")) đ</strong>
                        </div>

                        <div class="order-action-buttons">
                            <button type="submit" class="btn btn-primary btn-submit-cart">
                                🛒 Thêm vào giỏ hàng
                            </button>
                            <a asp-controller="GioHang" asp-action="Index" class="btn btn-outline-cart">
                                Xem giỏ hàng
                            </a>
                        </div>
                    </form>
                }
                else
                {
                    <div class="dish-out-of-stock-card">
                        <div class="alert-icon">⚠️</div>
                        <div>
                            <h4>Món ăn hiện tạm hết hàng</h4>
                            <p>Bếp đang chuẩn bị bổ sung nguyên liệu tươi mới. Quý khách vui lòng chọn món ăn khác hoặc quay lại sau ít phút.</p>
                            <a asp-controller="Menu" asp-action="Index" class="btn btn-secondary">Xem các món khác trong thực đơn</a>
                        </div>
                    </div>
                }

                <!-- Description & Details -->
                <div class="dish-description-block">
                    <h3 class="block-title">Mô tả món ăn</h3>
                    <p class="description-text">@dish.MoTa</p>

                    <div class="dish-specs">
                        <div class="spec-row">
                            <span class="spec-label">Phù hợp:</span>
                            <span class="spec-value">Thưởng thức tại gia, liên hoan gia đình, bạn bè (1 - 4 người)</span>
                        </div>
                        <div class="spec-row">
                            <span class="spec-label">Quy cách:</span>
                            <span class="spec-value">Đóng gói hộp chuyên dụng thực phẩm sạch kèm túi giữ nhiệt</span>
                        </div>
                        <div class="spec-row">
                            <span class="spec-label">Hướng dẫn:</span>
                            <span class="spec-value">Nấu sôi lại nước lẩu hoặc nhúng ăn kèm ngay khi vừa nhận</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Review & Feedback Section for this dish (Yêu cầu 4) -->
    <section class="dish-reviews-section" style="margin-top: 40px; background: white; border-radius: 20px; border: 1px solid var(--line); padding: 32px; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px; border-bottom:1px solid var(--line); padding-bottom:20px; margin-bottom:28px;">
            <div>
                <h2 style="font-size:24px; margin:0 0 6px;">💬 Đánh giá & Phản hồi về "@dish.TenMon"</h2>
                <p style="margin:0; color:var(--muted); font-size:14px;">Trải nghiệm ẩm thực thực tế từ những khách hàng đã thưởng thức món ăn này tại Lẩu Phố.</p>
            </div>
            <a href="/PhanHoi?maMon=@dish.MaMon" class="btn" style="padding:10px 20px; font-weight:700; border-radius:10px;">
                ⭐ Viết đánh giá món này
            </a>
        </div>

        <div style="display:grid; grid-template-columns: 280px 1fr; gap:36px; align-items:start;">
            <!-- Cột trái: Tóm tắt điểm số sao trung bình -->
            <div style="background:#fdfaf6; border:1px solid #fed7aa; border-radius:16px; padding:24px; text-align:center;">
                <div style="font-size:48px; font-weight:900; color:#c2410c; line-height:1;">
                    @dish.DiemDanhGiaTrungBinh.ToString("0.0")
                </div>
                <div style="color:#f59e0b; font-size:24px; margin:8px 0; letter-spacing:2px;">
                    @String.Concat(Enumerable.Repeat("★", (int)Math.Round(dish.DiemDanhGiaTrungBinh)))@String.Concat(Enumerable.Repeat("☆", 5 - (int)Math.Round(dish.DiemDanhGiaTrungBinh)))
                </div>
                <div style="font-size:14px; font-weight:600; color:#4b5563;">
                    Dựa trên @(Model.DanhGias.Count > 0 ? Model.DanhGias.Count : dish.SoLuongDanhGia) lượt đánh giá
                </div>
                <hr style="border:none; border-top:1px dashed #fdba74; margin:16px 0;" />
                <div style="font-size:12.5px; color:#6b7280; line-height:1.5;">
                    100% đánh giá từ khách hàng đã đặt món và thưởng thức thực tế.
                </div>
            </div>

            <!-- Cột phải: Danh sách đánh giá & Phản hồi (mới đến cũ) -->
            <div class="dish-reviews-list">
                @if (Model.DanhGias == null || Model.DanhGias.Count == 0)
                {
                    <div style="text-align:center; padding:32px 20px; background:#f9fafb; border-radius:12px; color:var(--muted);">
                        <div style="font-size:36px; margin-bottom:8px;">🍲</div>
                        <h4 style="margin:0 0 4px; color:#374151;">Chưa có đánh giá nào cho món này</h4>
                        <p style="margin:0; font-size:13.5px;">Hãy là người đầu tiên đặt món và chia sẻ cảm nhận tuyệt vời của bạn nhé!</p>
                    </div>
                }
                else
                {
                    <div style="display:flex; flex-direction:column; gap:20px;">
                        @foreach (var review in Model.DanhGias)
                        {
                            <div style="border:1px solid var(--line); border-radius:14px; padding:18px 20px; background:#ffffff;">
                                <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:8px;">
                                    <div style="display:flex; align-items:center; gap:10px;">
                                        <div style="width:38px; height:38px; border-radius:50%; background:#fef3c7; color:#b45309; display:flex; align-items:center; justify-content:center; font-weight:bold; font-size:15px;">
                                            @(string.IsNullOrEmpty(review.TenKhachHang) ? "K" : review.TenKhachHang[0].ToString().ToUpper())
                                        </div>
                                        <div>
                                            <strong style="font-size:14.5px; display:block;">@review.TenKhachHang</strong>
                                            <small class="muted" style="font-size:12px;">Đã dùng bữa · @review.NgayGui.ToString("dd/MM/yyyy · HH:mm")</small>
                                        </div>
                                    </div>
                                    <div class="stars" style="color:#f59e0b; font-size:16px; letter-spacing:2px;">
                                        @String.Concat(Enumerable.Repeat("★", review.DanhGia))@String.Concat(Enumerable.Repeat("☆", 5 - review.DanhGia))
                                    </div>
                                </div>

                                <p style="margin:10px 0; color:#334155; line-height:1.6; font-size:14px;">@review.NoiDung</p>

                                <!-- Hội thoại phản hồi của nhà hàng / khách hàng (xếp mới -> cũ) -->
                                @if (review.TraLois != null && review.TraLois.Count > 0)
                                {
                                    <div style="margin-top:12px; background:#f8fafc; border-radius:10px; padding:12px 16px; border-left:3px solid #3b82f6;">
                                        <small style="font-weight:700; color:#64748b; text-transform:uppercase; font-size:11.5px; display:block; margin-bottom:8px;">
                                            💬 Phản hồi trao đổi (@review.TraLois.Count câu trả lời)
                                        </small>
                                        <div style="display:flex; flex-direction:column; gap:8px;">
                                            @foreach (var reply in review.TraLois)
                                            {
                                                <div style="padding:8px 12px; border-radius:8px; background:@(reply.NguoiGui == "NhanVien" ? "#eff6ff" : "#ffffff"); border:1px solid @(reply.NguoiGui == "NhanVien" ? "#bfdbfe" : "#e2e8f0"); font-size:13px;">
                                                    <div style="display:flex; justify-content:space-between; margin-bottom:3px;">
                                                        <strong style="color:@(reply.NguoiGui == "NhanVien" ? "#1d4ed8" : "#334155");">
                                                            @(reply.NguoiGui == "NhanVien" ? "🏢 " + reply.NguoiTraLoi + " (Nhà hàng)" : "👤 " + reply.NguoiTraLoi)
                                                        </strong>
                                                        <span class="muted" style="font-size:11px;">@reply.NgayGui.ToString("dd/MM/yyyy · HH:mm")</span>
                                                    </div>
                                                    <div style="color:#1e293b; line-height:1.45;">@reply.NoiDung</div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                <!-- Phản hồi nhanh tại món ăn -->
                                <div style="margin-top:10px; border-top:1px dashed var(--line); padding-top:8px;">
                                    <form asp-controller="PhanHoi" asp-action="PhanHoiLai" method="post" style="display:flex; gap:8px;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="maDanhGia" value="@review.MaDanhGia" />
                                        <input type="hidden" name="returnUrl" value="/Menu/ChiTiet/@dish.MaMon" />
                                        <input type="text" name="noiDung" placeholder="Nhập câu trả lời hoặc trao đổi thêm..." required style="flex:1; padding:6px 12px; border-radius:8px; border:1px solid var(--line); font-size:13px;" />
                                        <button type="submit" class="btn small" style="padding:6px 14px; font-size:12.5px;">Gửi</button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- Related Dishes Section -->
    @if (Model.MonLienQuan.Count > 0)
    {
        <section class="related-dishes-section">
            <div class="section-heading">
                <div>
                    <h2>Món ngon cùng danh mục</h2>
                    <p>Khám phá thêm các lựa chọn hấp dẫn trong nhóm @dish.LoaiMon</p>
                </div>
                <a asp-controller="Menu" asp-action="Index" asp-route-loai="@dish.MaLoaiMon" class="text-btn">
                    Xem tất cả @dish.LoaiMon →
                </a>
            </div>

            <div class="dish-grid">
                @foreach (var relatedDish in Model.MonLienQuan)
                {
                    <partial name="_DishCard" model="@relatedDish" />
                }
            </div>
        </section>
    }
</div>

@section Scripts {
    <script>
        (function() {
            const unitPrice = @((dish.DonGiaSauGiam > 0 && dish.DonGiaSauGiam < dish.DonGia) ? dish.DonGiaSauGiam : dish.DonGia);
            const maxQuantity = @dish.SoLuong;
            const minusBtn = document.getElementById('detailMinusBtn');
            const plusBtn = document.getElementById('detailPlusBtn');
            const qtyInput = document.getElementById('detailQuantityInput');
            const liveSubtotal = document.getElementById('liveSubtotalText');

            function updateSubtotal() {
                if (!qtyInput) return;
                let qty = parseInt(qtyInput.value || '1', 10);
                if (isNaN(qty) || qty < 1) qty = 1;
                if (maxQuantity > 0 && qty > maxQuantity) qty = maxQuantity;
                qtyInput.value = qty;

                if (liveSubtotal) {
                    const total = qty * unitPrice;
                    liveSubtotal.textContent = total.toLocaleString('vi-VN') + ' đ';
                }
            }

            if (minusBtn && plusBtn && qtyInput) {
                minusBtn.addEventListener('click', function() {
                    let qty = parseInt(qtyInput.value || '1', 10);
                    if (qty > 1) {
                        qtyInput.value = qty - 1;
                        updateSubtotal();
                    }
                });

                plusBtn.addEventListener('click', function() {
                    let qty = parseInt(qtyInput.value || '1', 10);
                    if (qty < maxQuantity) {
                        qtyInput.value = qty + 1;
                        updateSubtotal();
                    }
                });

                qtyInput.addEventListener('input', updateSubtotal);
                qtyInput.addEventListener('change', updateSubtotal);
            }
        })();
    </script>
}
