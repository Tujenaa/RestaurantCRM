<footer>
    <div class="footer-inner">
        <div>
            <a class="brand" asp-controller="TrangChu" asp-action="Index">
                <span class="brand-name">Lẩu <em>Phố</em></span>
                <small>Ngon tại nhà</small>
            </a>
            <p class="footer-about">Chọn món ngon, giao tận cửa. Cảm ơn bạn đã đồng hành cùng Lẩu Phố!</p>
        </div>
        <div>
            <h3>Khách hàng</h3>
            <a asp-controller="Menu" asp-action="Index">Thực đơn</a>
            <a asp-controller="DonHang" asp-action="Index">Theo dõi đơn hàng</a>
            @if (string.IsNullOrEmpty(Context.Session.GetString("Token")))
            {
                <a asp-controller="TaiKhoan" asp-action="DangNhap">Tài khoản (Đăng nhập)</a>
            }
            else
            {
                <a asp-controller="TaiKhoan" asp-action="Index">Tài khoản cá nhân</a>
            }
        </div>
        <div>
            <h3>Chăm sóc khách hàng</h3>
            <a asp-controller="PhanHoi" asp-action="Index">Đánh giá &amp; phản hồi</a>
            <a asp-controller="KhaoSat" asp-action="Index">Khảo sát</a>
            <p>Hotline 1900 0000 · 09:00–22:00</p>
        </div>
    </div>
    <div class="copyright">© 2026 Lẩu Phố · Bản demo website khách hàng · Dữ liệu minh họa</div>
</footer>
