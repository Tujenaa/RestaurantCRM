<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@(ViewData["Title"] ?? "Lẩu Phố — Cổng khách hàng")</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        (function() {
            try {
                var y = sessionStorage.getItem('restoreScrollY');
                if (y !== null) {
                    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
                    window.scrollTo(0, parseInt(y, 10));
                }
            } catch(e){}
        })();
    </script>
</head>
<body>
    <partial name="/Shared/_Header.cshtml" />
    <main>
        @RenderBody()
    </main>
    <partial name="/Shared/_Footer.cshtml" />
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <!-- Quick View Modal Container -->
    <div class="quickview-modal" id="quickViewModal" aria-hidden="true" role="dialog">
        <div class="quickview-modal__backdrop" onclick="closeQuickView()"></div>
        <div class="quickview-modal__dialog">
            <button class="quickview-modal__close" onclick="closeQuickView()" aria-label="Đóng">✕</button>
            <div class="quickview-modal__content" id="quickViewContent">
                <div class="quickview-loading">
                    <div class="spinner"></div>
                    <p>Đang tải thông tin món ăn...</p>
                </div>
            </div>
        </div>
    </div>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (TempData["ThongBao"] is string notifyMsg)
    {
        var isErr = TempData["IsError"] as bool? == true || string.Equals(TempData["ThongBaoLoai"]?.ToString(), "error", StringComparison.OrdinalIgnoreCase);
        <script>
            (function() {
                var msg = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(notifyMsg));
                var isErr = @(isErr ? "true" : "false");
                var trigger = function() {
                    if (typeof window.showToast === 'function') {
                        window.showToast(msg, isErr);
                    }
                };
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', trigger);
                } else {
                    trigger();
                }
            })();
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
